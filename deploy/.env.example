# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# string  Portainer base URL as reachable from inside the dashboard container
PORTAINER_URL=http://192.168.0.17:19000

# string  Portainer access token (My account > Add access token). Or use
#         PORTAINER_API_KEY_FILE=/run/secrets/portainer_key
PORTAINER_API_KEY=

# string  Admin login password, minimum 8 characters. Or use ADMIN_PASSWORD_FILE
#         or ADMIN_PASSWORD_HASH (argon2id PHC string).
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Paths on the NAS
# ---------------------------------------------------------------------------

# path    Host directory for the SQLite database and session secret
DATA_PATH=/Volume1/DockerAppsData/homelab-dashboard

# int     Port published on the NAS for Nginx Proxy Manager to reach
DASHBOARD_PORT=5229

# ---------------------------------------------------------------------------
# Portainer
# ---------------------------------------------------------------------------

# list    Comma separated endpoint IDs to monitor. Empty means auto-discover all.
PORTAINER_ENDPOINT_IDS=

# ---------------------------------------------------------------------------
# Alerts (Telegram)
# ---------------------------------------------------------------------------

# string  Bot token from @BotFather. Leave both empty to disable delivery.
TELEGRAM_BOT_TOKEN=
# string  Chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# float   Sustained container CPU percent that fires an alert (default 90)
ALERT_CPU_PCT=90
# float   Sustained container memory percent of limit (default 90)
ALERT_MEM_PCT=90
# float   Mount usage percent (default 90)
ALERT_DISK_PCT=90
# int     Drive temperature in Celsius (default 55)
ALERT_DISK_TEMP_C=55
# int     Restarts within ALERT_RESTART_WINDOW that count as a loop (default 3)
ALERT_RESTART_COUNT=3
# duration (default 10m)
ALERT_RESTART_WINDOW=10m
# duration  How long a threshold must hold before firing (default 5m)
ALERT_SUSTAINED_FOR=5m
# duration  Minimum gap between state flips for one rule (default 2m)
ALERT_DEBOUNCE=2m
# duration  Host or Portainer unreachable for this long fires (default 2m)
ALERT_HOST_UNREACHABLE_FOR=2m

# ---------------------------------------------------------------------------
# Collection
# ---------------------------------------------------------------------------

# duration  Container stats poll (default 15s, minimum 5s)
STATS_INTERVAL=15s
# duration  Host, mount, and SMART poll (default 60s, minimum 10s)
HOST_INTERVAL=60s
# duration  Registry digest check (default 6h)
UPDATE_INTERVAL=6h
# int       Concurrent stats requests (default 8, range 1..64)
STATS_WORKERS=8
# duration  Per container stats call timeout (default 5s)
STATS_TIMEOUT=5s
# list      containerPath=label pairs. Any directory inside the container that lives on
#           the host filesystem you want to track. /hostfs/usr is the NAS root fs,
#           /data sits on /Volume1. (default /hostfs/usr=/,/data=/Volume1)
TRACKED_MOUNTS=/hostfs/usr=/,/data=/Volume1
# list      Glob patterns of container names to hide (default empty)
EXCLUDE_PATTERNS=
# string    Compose project name of this stack, always hidden (default homelab-dashboard)
OWN_STACK=homelab-dashboard
# list      Regex patterns that classify a log line as an error
LOG_ERROR_PATTERNS=(?i)error|exception|fatal|panic|traceback

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# int   Days of 5-minute history to keep (default 90)
RETENTION_DAYS=90
# int   Alert when the SQLite file exceeds this many MB (default 500, minimum 16)
DB_MAX_MB=500

# ---------------------------------------------------------------------------
# Registries
# ---------------------------------------------------------------------------

# string  host=user:password pairs, comma separated. Empty for public images only.
#         Example: ghcr.io=malkurbi5:ghp_xxx,registry-1.docker.io=malkurbi5:dckr_pat_xxx
REGISTRY_AUTH=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# string    IANA timezone for timestamps in the UI and alerts (default Asia/Riyadh)
TZ=Asia/Riyadh
# string    debug | info | warn | error (default info)
LOG_LEVEL=info
# duration  Login session lifetime (default 168h)
SESSION_TTL=168h
# bool      Set Secure on cookies. Keep true behind HTTPS on NPM (default true)
SECURE_COOKIES=true
# string    Optional fixed session signing secret. Generated and stored in DATA_PATH if empty.
SESSION_SECRET=


# ---------------------------------------------------------------------------
# Container identity
# ---------------------------------------------------------------------------

# int   UID and GID the dashboard runs as. DATA_PATH must be owned by this pair.
PUID=65532
PGID=65532
# string  Interface to publish on. 0.0.0.0 for NPM on the same NAS, or 127.0.0.1 with a host network NPM.
DASHBOARD_BIND=0.0.0.0
# string  Image tag to pull (default latest)
DASHBOARD_TAG=latest
# duration  SMART poll interval inside the sidecar (default 5m, minimum 30s)
SMART_INTERVAL=5m
# list      Explicit devices for the sidecar, empty scans automatically
SMART_DEVICES=
